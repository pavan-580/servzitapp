# Local development only. Never place production credentials in source control.
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://servzit:servzit_local_only@localhost:5432/servzit
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_POOL_MAX=10
POSTGRES_DB=servzit
POSTGRES_USER=servzit
POSTGRES_PASSWORD=servzit_local_only
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
JWT_ACCESS_SECRET=replace-with-a-local-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-local-random-secret-of-at-least-32-characters
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=replace-with-your-twilio-verify-service-sid
